@baseUrl = http://localhost:1198/api
@token = paste-the-login-token-here

### health check
GET {{baseUrl}}/health

### login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "user1@mail.com",
    "password": "password1"
}

### search
GET {{baseUrl}}/search?title=sunday
Authorization: Bearer {{token}}
